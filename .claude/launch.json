{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexara-site-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "nexara-site",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "nexara-site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "nexara-site",
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "nexara-site-next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "nexara-site-next",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "nexara-site-next-dev-3050",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "nexara-site-next",
        "run",
        "dev",
        "--",
        "-p",
        "3050"
      ],
      "port": 3050
    },
    {
      "name": "nexara-site-next-start",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd nexara-site-next && npx next start -p 3060"
      ],
      "port": 3060
    },
    {
      "name": "nexara-site-next-worker",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd nexara-site-next && npx wrangler dev --port 8787 --ip 127.0.0.1"
      ],
      "port": 8787
    }
  ]
}